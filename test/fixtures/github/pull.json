    "gists_url": "https://api.github.com/users/pluiedev/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/pluiedev/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/pluiedev/subscriptions",
    "organizations_url": "https://api.github.com/users/pluiedev/orgs",
