diff --git a/jest_esm_transformer.js b/jest_esm_transformer.js
new file mode 100644
index 0000000000000000000000000000000000000000..7154ab41095b74312b4f666319b0d64847e71689
--- /dev/null
+++ b/jest_esm_transformer.js
@@ -0,0 +1,17 @@
+const esbuild = require('esbuild');
+
+// why: A handful of node_modules packages ship ESM-only builds (@anycable/core, p-queue,
+//      p-timeout, nanoevents, uuid). ts-jest can't process them, so we transpile them to
+//      CommonJS with esbuild before jest requires them.
+module.exports = {
+  process(sourceText, filename) {
+    const { code, map } = esbuild.transformSync(sourceText, {
+      loader: 'js',
+      format: 'cjs',
+      target: 'node18.17',
+      sourcefile: filename,
+      sourcemap: true,
+    });
+    return { code, map };
+  },
+};
