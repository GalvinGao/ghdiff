{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react", "promise", "node", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "import/no-relative-parent-imports": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "_splat",
          "__typename",
          "__GHDIFF_VERSION__",
          "__GHDIFF_LOCAL__"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**", ".storybook/**"],
      "rules": { "import/no-relative-parent-imports": "off" }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.tanstack/**",
    "**/.wrangler/**",
    "src/routeTree.gen.ts",
    "src/lib/server/forges/gqlgen/",
    "worker-configuration.d.ts",
    "src/paraglide/**",
    "src/lib/server/ghdiff.user.js",
    "storybook-static"
  ]
}
