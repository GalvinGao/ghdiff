{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react", "nextjs", "promise", "node", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "nextjs/no-img-element": "off",
    "typescript/no-explicit-any": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/node_modules/**",
    "next-env.d.ts"
  ]
}
