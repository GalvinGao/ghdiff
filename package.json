{
  "name": "ghdiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm i18n:compile && vite dev",
    "build": "pnpm i18n:compile && vite build",
    "build:cli": "pnpm i18n:compile && vite build --config vite.cli-web.config.ts && vite build --config vite.cli-bin.config.ts",
    "cli": "pnpm build:cli && node dist/cli/bin/ghdiff.js",
    "build:node": "pnpm i18n:compile && GHDIFF_TARGET=node vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.dev.vars .output/server/index.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "pnpm i18n:compile && pnpm codegen:cf && tsc --noEmit",
    "lint": "pnpm i18n:check && oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "codegen": "pnpm run '/^codegen:.*/'",
    "codegen:cf": "WRANGLER_HIDE_BANNER=true wrangler types",
    "codegen:gql": "graphql-codegen --config codegen.ts",
    "test": "pnpm run '/^test:[^:]+$/'",
    "test:lib": "pnpm i18n:compile && vitest run --project lib --project cli",
    "test:e2e": "pnpm i18n:compile && vitest run --project gitlab --project github",
    "test:e2e:gitlab": "pnpm i18n:compile && vitest run --project gitlab",
    "test:e2e:github": "pnpm i18n:compile && vitest run --project github",
    "i18n:compile": "node scripts/compile-i18n.mjs && node scripts/build-userscript.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:shot": "node scripts/storybook-shot.mjs",
    "storybook:video": "node .agents/skills/pr-visual-evidence/scripts/record-interaction.mjs scripts/storybook-dialog.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@gitbeaker/core": "^43.8.0",
    "@gitbeaker/requester-utils": "^43.8.0",
    "@hono/node-server": "^2.1.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/paraglide-js-react": "^1.0.3",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql": "^9.0.5",
    "@octokit/request-error": "^7.1.2",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@pierre/diffs": "1.3.6",
    "@pierre/icons": "^0.7.1",
    "@pierre/theme": "^2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@primer/octicons-react": "^19.33.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "citty": "^0.2.2",
    "clsx": "^2.1.1",
    "cron-schedule": "6.0.0",
    "cronstrue": "^3.24.0",
    "evlog": "^2.27.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "jotai": "^2.20.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@inlang/plugin-message-format": "4.4.0",
    "@j178/prek": "^0.4.14",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "graphql": "^17.0.2",
    "msw": "^2.15.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@12.4.1"
}
