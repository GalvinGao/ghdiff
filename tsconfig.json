{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // `import appCss from '@/globals.css?url'` is a Vite import, and
    // `import.meta.env` is Vite's.
    "types": ["vite/client"],
    // Test files import siblings with an explicit .ts extension so that
    // `node --test --experimental-strip-types` can resolve them without a
    // bundler.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".tanstack", ".wrangler"]
}
